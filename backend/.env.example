# Copia questo file in .env e compila i valori. .env NON va mai committato
# (è già in .gitignore) e non deve mai contenere segreti hardcoded nel codice.

# --- Flask / sessione app ---
FLASK_ENV=development
# Chiave per firmare i cookie di sessione Flask. Genera con:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Hash della password applicativa (ADR-0002). Genera con:
# python -c "from werkzeug.security import generate_password_hash as g; print(g('la-tua-password'))"
APP_PASSWORD_HASH=

# --- Database (Supabase) ---
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# --- AI providers ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Servizi esterni ---
OPENWEATHER_API_KEY=

# --- Google OAuth 2.0 (Gmail + Calendar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/callback

# Chiave per cifrare i token OAuth con AES-256-GCM prima di salvarli su Supabase
# (requisito non negoziabile: nessun segreto in chiaro nel DB). Genera con:
# python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_ENCRYPTION_KEY=

# --- Timeout servizi esterni (secondi, requisito non negoziabile: max 5s) ---
EXTERNAL_SERVICE_TIMEOUT_SECONDS=5
